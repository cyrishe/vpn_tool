[Unit]
Description=Regional VPN WireGuard gateway agent
After=network-online.target wg-quick@wg-regional.service
Wants=network-online.target
Requires=wg-quick@wg-regional.service

[Service]
Type=notify
WorkingDirectory=/opt/regional-vpn-gateway/service
ExecStartPre=/usr/sbin/ip link set dev wg-regional up
ExecStart=/usr/bin/python3 -m gateway_agent.agent --control-url ${VPN_CONTROL_URL} --credentials /etc/regional-vpn/gateway.json --interface wg-regional
EnvironmentFile=/etc/regional-vpn/agent.env
ExecStopPost=/usr/sbin/ip link set dev wg-regional down
WatchdogSec=20
TimeoutStartSec=20
TimeoutStopSec=5
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
